# ═══════════════════════════════════════════════════════════
# MIDNIGHT MONK FRONTEND - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════
# DO NOT COMMIT .env files with real credentials
# Copy this file to .env and fill in your own values

# Backend API URL
# Development: http://localhost:8000
# Production: Your Render backend URL (e.g., https://mnm-backend.onrender.com)
VITE_API_URL=http://localhost:8000

# Live Order Tracking (Leaflet + OpenStreetMap)
# Uses OpenStreetMap tiles and Leaflet — no external API key required!

# Socket.IO Configuration (optional, for real-time features)
# VITE_SOCKET_URL=http://localhost:8000
