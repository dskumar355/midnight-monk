# ═══════════════════════════════════════════════════════════
# MIDNIGHT MONK - ENVIRONMENT VARIABLES TEMPLATE
# ═══════════════════════════════════════════════════════════
# Copy this file to .env or place corresponding files in /backend and /frontend
# NEVER commit real credentials to source control.

# --- Backend Configuration (Flask / MongoDB) ---
# Location: backend/.env
PORT=8000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/midnight_monk?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
FLASK_ENV=development

# Razorpay Payment Gateway (Production / Staging)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Optional: Cloudinary for Food Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend Configuration (React + Vite) ---
# Location: frontend/.env
VITE_API_URL=http://localhost:8000

# Live Order Tracking (Leaflet + OpenStreetMap)
# Uses OpenStreetMap tiles and Leaflet — no external API key required!
