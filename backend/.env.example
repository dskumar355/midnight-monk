# ═══════════════════════════════════════════════════════════
# MIDNIGHT MONK BACKEND - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════
# DO NOT COMMIT .env files with real credentials
# Copy this file to .env and fill in your own values

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/midnight_monk
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/midnight_monk
MONGO_URI=mongodb://127.0.0.1:27017/midnight_monk

# JWT Secret for token signing
# Should be a long, random string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_jwt_secret_here_use_a_long_random_string

# Server Port
PORT=8000

# Optional: Twilio credentials for SMS notifications
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Optional: Email notifications
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optional: Razorpay for payment processing
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
